rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // A signed-in user can read and write only their own document
    // and everything nested under it (tasks, data/marks, data/examConfig).
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
